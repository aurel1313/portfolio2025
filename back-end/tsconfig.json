
{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
  
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
  },
  "include": ["./**/*.ts", "./**/*.js"],
  "exclude": ["node_modules", "**/*.spec.ts", "dist"]
}
